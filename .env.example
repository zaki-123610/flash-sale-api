# Neon connection string (Dashboard > Connect). The pooled host ("-pooler") is recommended.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Only used by the test suite. Must be a separate database (e.g. a Neon branch): tests drop all tables.
TEST_DATABASE_URL=

# Optional
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# BCRYPT_ROUNDS=12
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# MAX_QUANTITY_PER_ORDER=5
